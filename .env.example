# SENTINEL-X — configuration NON secrète (copiée en .env par scripts/setup.sh).
# Les secrets (mots de passe, clés) sont dans ./secrets/ : jamais dans ce fichier, jamais dans Git.

# IP de l'hôte sur laquelle publier les ports 443/80/8883.
# 0.0.0.0 = toutes les interfaces ; mettre l'IP du réseau de table (ex. 192.168.137.10) pour restreindre.
BIND_IP=0.0.0.0

# Identité du boîtier ESP32 (= compte MQTT, = node_id dans les topics)
NODE_ID=sentinel-edge-01
# node_id auquel la clé API de l'IA vision est liée
VISION_NODE_ID=sentinel-vision-01

# Base de données
DB_NAME=sentinel
DB_USER=sentinel_app

# Comptes du dashboard (mots de passe : secrets/admin_password, secrets/viewer_password)
ADMIN_USERNAME=admin
VIEWER_USERNAME=operateur

# Documentation Swagger (/docs) : désactivée en production
API_DOCS_ENABLED=false
# Origines supplémentaires autorisées (dev uniquement), séparées par des virgules
ALLOWED_ORIGINS=

# IA vision : index de la webcam (voir docker-compose.camera.yml sous Linux)
CAMERA_SOURCE=0

# Sauvegardes PostgreSQL : toutes les 6 h, 28 copies conservées (7 jours)
BACKUP_INTERVAL_S=21600
BACKUP_KEEP=28

# IA prédictive : part des mesures d'entraînement considérées anormales (0.01 = 1 %).
# 0.1 rend le modèle plus sensible mais génère beaucoup plus de fausses alertes.
ML_CONTAMINATION=0.01
