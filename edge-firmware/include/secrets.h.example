// Modèle de configuration du boîtier. Le vrai fichier include/secrets.h est ignoré par Git.
// Il est généré automatiquement par  bash scripts/setup.sh  (CA, mot de passe MQTT, node_id) :
// il ne reste qu'à renseigner le Wi-Fi.
#pragma once

// Réseau de table : point d'accès SENTINEL-X (WPA2-PSK AES, 2,4 GHz)
#define WIFI_SSID     "SENTINEL-X"
#define WIFI_PASSWORD "CHANGE_ME"

// Adresse du PC serveur : doit figurer dans le certificat du broker (SAN)
#define MQTT_HOST "192.168.137.10"
#define MQTT_PORT 8883

// Adresse fixe du boîtier (facultatif : sans ces deux lignes, DHCP)
#define ESP_STATIC_IP "192.168.137.20"
#define ESP_GATEWAY   "192.168.137.1"

// Identité MQTT du boîtier : sert aussi de node_id dans les topics (verrouillé par l'ACL)
#define NODE_ID   "sentinel-edge-01"
#define MQTT_PASS "CHANGE_ME"

// Contenu de infra-cyber/certs/ca.crt (CA interne qui a signé le certificat du broker)
static const char MQTT_CA_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
)EOF";
